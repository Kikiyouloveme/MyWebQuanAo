# ============================================================
# VELATHIER — biến môi trường
#
# Sao chép file này thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
#
# KHÔNG commit file `.env` lên git (đã có trong .gitignore).
# Để trống các mục tùy chọn thì hệ thống chạy ở chế độ thử nghiệm —
# vẫn dùng được đầy đủ chức năng khi phát triển.
# ============================================================

# ---------- Chung ----------
NODE_ENV=development
PORT=5173
MONGO_URI=mongodb://127.0.0.1:27017/velathier
CORS_ORIGINS=http://localhost:3000

# Origin công khai — dùng cho VNPay callback, liên kết trong email và sitemap.
# Khi lên production phải là tên miền thật, ví dụ https://velathier.vn
PUBLIC_URL=http://localhost:5173

# Khóa ký JWT. BẮT BUỘC ở production và phải dài tối thiểu 32 ký tự.
# Sinh khóa ngẫu nhiên:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Quy tắc bán hàng ----------
# Phí vận chuyển cố định (VNĐ)
SHIPPING_FLAT_FEE=40000
# Miễn phí vận chuyển khi giá trị đơn SAU KHI trừ mã giảm giá đạt mức này
SHIPPING_FREE_THRESHOLD=750000

# ---------- VNPay ----------
# Đăng ký tài khoản thử nghiệm: https://sandbox.vnpayment.vn/devreg/
# Để trống → dùng cổng giả lập nội bộ (vẫn ký và xác thực HMAC-SHA512 thật,
# nhưng KHÔNG thu được tiền thật).
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Default manual reconciliation. Do NOT enable until provider refund/crash recovery is qualified.
VNP_REFUND_AUTOMATION_ENABLED=0

# ---------- VietQR POS (chuyển khoản ngân hàng tại quầy) ----------
# Mã QR sinh theo chuẩn EMVCo/NAPAS 247, bám đúng số tiền và nội dung của đơn.
# Để trống → phương thức "Chuyển khoản VietQR" bị ẩn khỏi checkout và bảng POS.
# VIETQR_BANK_BIN: BIN 6 số của ngân hàng nhận tiền (vd MB Bank = 970422)
# VIETQR_ACCOUNT_NO: số tài khoản nhận tiền
# VIETQR_ACCOUNT_NAME: tên chủ tài khoản (hiển thị cho khách đối chiếu)
# VIETQR_TTL_MINUTES: mã QR hiển thị nhắc lại trong bao nhiêu phút
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_ACCOUNT_TYPE=individual
VIETQR_TTL_MINUTES=15

# Khi lên production đổi thành:
#   VNP_URL=https://vnpayment.vn/paymentv2/vpcpay.html
#   VNP_API_URL=https://vnpayment.vn/merchant_webapi/api/transaction

# ---------- Email (SMTP) ----------
# Để trống SMTP_HOST → email được lưu vào hộp thư nội bộ, xem tại Admin → Email.
# Lưu ý: khách sẽ KHÔNG nhận được mã OTP nếu chưa cấu hình SMTP thật.
# Với Gmail cần dùng "mật khẩu ứng dụng", không phải mật khẩu đăng nhập.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VELATHIER <no-reply@velathier.vn>

# ---------- Private storage / production ----------
# Local adapter is development-only. Production requires a PRIVATE S3 bucket,
# block-public-access, versioning and least-privilege IAM (credentials injected by host).
PRIVATE_STORAGE_PROVIDER=local
# PRIVATE_STORAGE_BUCKET=
# AWS_REGION=ap-southeast-1
# S3_ENDPOINT=https://your-compatible-object-store
# S3_FORCE_PATH_STYLE=1
# PRIVATE_STORAGE_ROOT=E:/private-velathier
# OUTBOX_ENCRYPTION_KEY=<independent random secret, minimum 32 characters>
# Fonts must be licensed on the render host: arial.ttf, georgia.ttf, cour.ttf.
# PRINT_FONT_DIR=C:/Windows/Fonts
# Empty TRUST_PROXY = no proxy trusted. Specify ONLY actual proxy IP/CIDR values.
TRUST_PROXY=
