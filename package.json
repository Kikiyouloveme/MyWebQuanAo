{
  "name": "velathier",
  "version": "3.0.0",
  "private": true,
  "description": "VELATHIER — website thương mại điện tử thời trang (React + Express + VNPay)",
  "main": "server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "seed": "node server/seed.js",
    "build": "npm --prefix client run build",
    "typecheck": "npm --prefix client run typecheck",
    "test:api": "node server/test-api.js",
    "setup": "npm install && npm --prefix client install && npm run seed && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.4"
  }
}
